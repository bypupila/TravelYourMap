{
  "name": "travelyourmap-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && next dev",
    "build": "node scripts/copy-assets.mjs && next build",
    "start": "next start",
    "design-ai": "npx -y magicpath-ai",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:history": "node scripts/check-secrets-history.mjs",
    "security:deps-age": "node scripts/check-package-release-age.mjs",
    "security:workflow-pinning": "node scripts/check-workflow-pinning.mjs",
    "security:install-hooks": "./scripts/install-git-hooks.sh",
    "security:rotate-auth": "node scripts/rotate-auth-session-secret.mjs",
    "youtube:embed-audit": "node scripts/audit-youtube-embeds.mjs",
    "release:check": "npm run lint && npx tsc --noEmit --incremental false && npm run build && npm run validate:env && npm run security:secrets && npm run security:workflow-pinning && npm run security:deps-age && npm run youtube:embed-audit",
    "release:gate": "node scripts/release-gate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrations:status": "node scripts/db-migrate.mjs --status",
    "mvp:smoke": "node scripts/mvp-smoke.mjs",
    "visual:capture": "node scripts/capture-visual-library.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "polar:bootstrap": "node scripts/polar-bootstrap-travel.mjs",
    "user:set-role": "node scripts/set-user-role.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@polar-sh/sdk": "^0.48.1",
    "@sentry/nextjs": "10.65.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "3.2.1",
    "flag-icons": "7.5.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "posthog-js": "1.399.4",
    "posthog-node": "5.41.0",
    "prop-types": "^15.8.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-globe.gl": "^2.38.0",
    "recharts": "^3.9.2",
    "resend": "6.17.2",
    "shadcn": "^4.13.0",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "playwright": "1.61.1",
    "postcss": "^8.5.19",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@typescript-eslint/project-service": "8.58.1",
    "@typescript-eslint/scope-manager": "8.58.1",
    "@typescript-eslint/tsconfig-utils": "8.58.1",
    "@typescript-eslint/type-utils": "8.58.1",
    "@typescript-eslint/types": "8.58.1",
    "@typescript-eslint/typescript-estree": "8.58.1",
    "@typescript-eslint/utils": "8.58.1",
    "@typescript-eslint/visitor-keys": "8.58.1",
    "typescript-eslint": "8.58.1",
    "postcss": "$postcss"
  }
